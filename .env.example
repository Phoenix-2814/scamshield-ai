# Optional local overrides. Production deployments should set these in the host environment.
HOST=127.0.0.1
PORT=8787
MAX_BODY_BYTES=24000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# Comma-separated browser origins; same-origin requests are allowed automatically.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI analysis. Copy this file to .env, uncomment one provider, and add its key.
# Keep provider keys server-side; never put them in frontend/.env or a VITE_ variable.
# Groq
# SCAMSHIELD_AI_PROVIDER=groq
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_API_KEY=your_key_here
# Gemini
# SCAMSHIELD_AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=your_key_here

# Optional automatic VirusTotal URL reputation checks (server-side key only).
# VIRUSTOTAL_API_KEY=your_key_here
# VIRUSTOTAL_REQUESTS_PER_MINUTE=4
