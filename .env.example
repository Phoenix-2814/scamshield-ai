# Optional local overrides. Production deployments should set these in the host environment.
HOST=127.0.0.1
PORT=8787
MAX_BODY_BYTES=24000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# Comma-separated browser origins; same-origin requests are allowed automatically.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional semantic analysis. Keep the API key server-side; never put it in frontend/.env.
# Leave the provider as "rules" until you have configured a key and chosen to enable external AI processing.
SCAMSHIELD_AI_PROVIDER=rules
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY is intentionally not populated here.
