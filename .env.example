# Optional local overrides. Production deployments should set these in the host environment.
HOST=127.0.0.1
PORT=8787
MAX_BODY_BYTES=24000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# Comma-separated browser origins; same-origin requests are allowed automatically.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI analysis. Copy this file to .env, then uncomment the provider and add
# your key. Keep the key server-side; never put it in frontend/.env or a VITE_ variable.
# SCAMSHIELD_AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=your_key_here
